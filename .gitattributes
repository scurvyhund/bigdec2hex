# Language classification (GitHub Linguist).
#
# This is a C project, but the test harness is larger than the program
# (test-final-d2h.sh ~7.0 KB vs final-d2h.c ~6.0 KB) and Linguist
# classifies by byte count -- so the repo was being reported as Shell
# and did not appear under `language:c`.
#
# Marking the test script as not detectable leaves C as the primary
# language. The script is still syntax-highlighted as Shell.

test-final-d2h.sh linguist-detectable=false

*.c linguist-language=C
*.h linguist-language=C
